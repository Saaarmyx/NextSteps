# NextSteps — Variables de Entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local a Git.

# Obligatorias
BOT_TOKEN=                    # Token de @BotFather (Telegram)
CHAT_ID=                      # Chat ID destino (usuario o grupo)

# Opcionales
SESSION_SECRET=               # Clave HMAC para firmar cookies (si vacía, deriva de BOT_TOKEN)
RECIPIENT_NAME=               # Nombre de la persona destinataria (vacío = genérico)
ALLOWED_ORIGIN=               # Origen permitido para POST (ej. https://midominio.com)
INCLUDE_CLIENT_META=false     # true = adjuntar IP y OS al mensaje Telegram