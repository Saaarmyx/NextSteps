# Token del bot de Telegram (@BotFather)
BOT_TOKEN=1234567890:tu_token_aqui

# ID del chat o usuario que recibe la notificación
CHAT_ID=123456789

# Opcional: nombre de la persona destinataria (si no se define, el mensaje es genérico)
